# HiveMQ Cloud Serverless
SECRET_HIVEMQ_HOST=your-cluster.s1.eu.hivemq.cloud
SECRET_HIVEMQ_TCP_PORT=8883
SECRET_HIVEMQ_WS_PORT=8884
SECRET_ESP32_MQTT_USERNAME=replace-with-device-username
SECRET_ESP32_MQTT_PASSWORD=replace-with-device-password
SECRET_MIRROR_MQTT_USERNAME=replace-with-mirror-username
SECRET_MIRROR_MQTT_PASSWORD=replace-with-mirror-password
SECRET_MQTT_TOPIC_PREFIX=smartmirror/demo

# Wokwi Automation CLI (free CI token, only needed for automated sensor demos)
SECRET_WOKWI_CLI_TOKEN=replace-with-wokwi-ci-token

# Cloud services
SECRET_OPENWEATHERMAP_API_KEY=replace-with-openweathermap-api-key
SECRET_GOOGLE_CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/replace-with-private-ics/basic.ics

# Rule Engine
ALERT_TEMP_HIGH_C=30
ALERT_HUMIDITY_HIGH_PCT=80
ALERT_COOLDOWN_MINUTES=15

# Telegram Bot API
ALERT_TELEGRAM_ENABLED=false
SECRET_TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
SECRET_TELEGRAM_CHAT_ID=replace-with-telegram-chat-id

# Gmail SMTP (use a Google App Password, never your account password)
ALERT_GMAIL_ENABLED=false
SECRET_GMAIL_USER=replace-with-sender@gmail.com
SECRET_GMAIL_APP_PASSWORD=replace-with-16-character-app-password
SECRET_GMAIL_TO=replace-with-recipient@example.com

# History
HISTORY_SAMPLE_SECONDS=60

# Optional Firebase Firestore
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
FIREBASE_COLLECTION=smartmirrorTelemetry
SECRET_FIREBASE_SERVICE_ACCOUNT_B64=replace-with-one-line-base64-json
